import { ethers } from 'ethers'
import mongoose from 'mongoose'
import { BlockchainTransactionModel, IBlockchainTransaction } from './models/BlockchainTransaction'
import { BlockModel, IBlock } from './models/Block'
import { AuditEventModel } from './models/AuditEvent'

/**
 * Store comprehensive blockchain transaction details in MongoDB
 */
export async function storeTransaction(
    receipt: ethers.TransactionReceipt,
    tx: ethers.TransactionResponse,
    functionName?: string,
    functionParameters?: any,
    auditEventId?: string,
    relatedEntity?: { type: 'GenomicData' | 'Consent' | 'AccessLog' | 'Registration'; id: string }
): Promise<IBlockchainTransaction> {
    try {
        // Parse events from transaction logs
        const events: any[] = []
        for (let i = 0; i < receipt.logs.length; i++) {
            const log = receipt.logs[i]
            try {
                // Try to parse the log (this is a simplified approach)
                events.push({
                    name: `Event${i}`, // You can enhance this with actual event parsing
                    signature: log.topics[0] || '',
                    args: {
                        topics: log.topics,
                        data: log.data
                    },
                    address: log.address,
                    logIndex: log.index
                })
            } catch (error: any) {
                console.warn(`Failed to parse log ${i}:`, error?.message || error)
            }
        }

        const transactionData: Partial<IBlockchainTransaction> = {
            // Transaction Details
            txHash: receipt.hash,
            blockNumber: receipt.blockNumber,
            blockHash: receipt.blockHash,
            transactionIndex: receipt.index,
            
            // Gas Information
            gasUsed: receipt.gasUsed.toString(),
            gasPrice: (tx.gasPrice && tx.gasPrice.toString) ? tx.gasPrice.toString() : '0',
            gasLimit: tx.gasLimit.toString(),
            effectiveGasPrice: tx.gasPrice?.toString() || '0',
            maxFeePerGas: (tx.maxFeePerGas && tx.maxFeePerGas.toString) ? tx.maxFeePerGas.toString() : undefined,
            maxPriorityFeePerGas: (tx.maxPriorityFeePerGas && tx.maxPriorityFeePerGas.toString) ? tx.maxPriorityFeePerGas.toString() : undefined,
            
            // Transaction Details
            from: tx.from,
            to: tx.to || '',
            value: tx.value.toString(),
            data: tx.data,
            nonce: tx.nonce,
            
            // Status & Timing
            status: receipt.status === 1,
            timestamp: new Date(), // You can get block timestamp from block
            confirmations: receipt.confirmations,
            
            // Contract Interaction Details
            contractAddress: tx.to,
            functionName,
            functionParameters,
            
            // Event Information
            events,
            
            // System Integration
            auditEventId: auditEventId ? new mongoose.Types.ObjectId(auditEventId) : undefined,
            relatedEntity,
            
            // Metadata
            networkId: process.env.NETWORK_ID || 'localhost'
        }

        const storedTransaction = await BlockchainTransactionModel.create(transactionData)
        console.log(`[BlockchainStorage] Stored transaction ${receipt.hash}`)
        
        return storedTransaction
    } catch (error: any) {
        console.error('[BlockchainStorage] Failed to store transaction:', error?.message || error)
        throw error
    }
}

/**
 * Store block information in MongoDB
 */
export async function storeBlock(blockNumber: number, provider: ethers.JsonRpcProvider): Promise<IBlock> {
    try {
        const block = await provider.getBlock(blockNumber)
        if (!block) {
            throw new Error(`Block ${blockNumber} not found`)
        }

        const blockData: Partial<IBlock> = {
            blockNumber: block.number,
            blockHash: block.hash,
            parentHash: block.parentHash,
            timestamp: new Date(block.timestamp * 1000),
            miner: block.miner,
            difficulty: block.difficulty.toString(),
            totalDifficulty: block.totalDifficulty?.toString() || '0',
            size: block.size,
            gasLimit: block.gasLimit.toString(),
            gasUsed: block.gasUsed.toString(),
            transactionCount: block.transactions.length,
            transactionHashes: block.transactions,
            networkId: process.env.NETWORK_ID || 'localhost'
        }

        const storedBlock = await BlockModel.create(blockData)
        console.log(`[BlockchainStorage] Stored block ${blockNumber}`)
        
        return storedBlock
    } catch (error: any) {
        console.error(`[BlockchainStorage] Failed to store block ${blockNumber}:`, error?.message || error)
        throw error
    }
}

/**
 * Get transaction with full details
 */
export async function getTransactionDetails(txHash: string): Promise<IBlockchainTransaction | null> {
    try {
        return await BlockchainTransactionModel.findOne({ txHash })
            .populate('auditEventId')
            .populate('relatedEntity.id')
            .exec()
    } catch (error: any) {
        console.error(`[BlockchainStorage] Failed to get transaction ${txHash}:`, error?.message || error)
        return null
    }
}

/**
 * Get block with full details
 */
export async function getBlockDetails(blockNumber: number): Promise<IBlock | null> {
    try {
        return await BlockModel.findOne({ blockNumber }).exec()
    } catch (error: any) {
        console.error(`[BlockchainStorage] Failed to get block ${blockNumber}:`, error?.message || error)
        return null
    }
}

/**
 * Get transactions by address
 */
export async function getTransactionsByAddress(
    address: string, 
    limit: number = 50, 
    offset: number = 0
): Promise<IBlockchainTransaction[]> {
    try {
        return await BlockchainTransactionModel.find({
            $or: [{ from: address }, { to: address }]
        })
        .sort({ timestamp: -1 })
        .limit(limit)
        .skip(offset)
        .populate('auditEventId')
        .exec()
    } catch (error: any) {
        console.error(`[BlockchainStorage] Failed to get transactions for ${address}:`, error?.message || error)
        return []
    }
}

/**
 * Get transactions by function name
 */
export async function getTransactionsByFunction(
    functionName: string,
    limit: number = 50,
    offset: number = 0
): Promise<IBlockchainTransaction[]> {
    try {
        return await BlockchainTransactionModel.find({ functionName })
            .sort({ timestamp: -1 })
            .limit(limit)
            .skip(offset)
            .populate('auditEventId')
            .exec()
    } catch (error: any) {
        console.error(`[BlockchainStorage] Failed to get transactions for function ${functionName}:`, error?.message || error)
        return []
    }
}

/**
 * Get blockchain statistics
 */
export async function getBlockchainStats(): Promise<{
    totalTransactions: number
    totalBlocks: number
    totalGasUsed: string
    successRate: number
    recentTransactions: IBlockchainTransaction[]
}> {
    try {
        const totalTransactions = await BlockchainTransactionModel.countDocuments()
        const totalBlocks = await BlockModel.countDocuments()
        
        const gasStats = await BlockchainTransactionModel.aggregate([
            { $group: { _id: null, totalGas: { $sum: "$gasUsed" } } }
        ])
        
        const successCount = await BlockchainTransactionModel.countDocuments({ status: true })
        const successRate = totalTransactions > 0 ? (successCount / totalTransactions) * 100 : 0
        
        const recentTransactions = await BlockchainTransactionModel.find()
            .sort({ timestamp: -1 })
            .limit(10)
            .exec()

        return {
            totalTransactions,
            totalBlocks,
            totalGasUsed: gasStats[0]?.totalGas || '0',
            successRate,
            recentTransactions
        }
    } catch (error: any) {
        console.error('[BlockchainStorage] Failed to get stats:', error?.message || error)
        return {
            totalTransactions: 0,
            totalBlocks: 0,
            totalGasUsed: '0',
            successRate: 0,
            recentTransactions: []
        }
    }
}
